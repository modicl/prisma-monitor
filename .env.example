# prisma-monitor — variables de entorno (en el compose local las define docker-compose.yml de la raíz).
# Ninguna es un secreto salvo la contraseña dentro de MONITOR_DATABASE_URL.

PORT=3020

# true (local): este servicio también sirve el front. false (producción): solo API; el front vive en Amplify.
SERVE_FRONT=true

# Kafka. Vacío => el monitor arranca sin consumir.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=prisma.agent-events

# Respaldo en tabla log. Vacío => sin respaldo (las métricas siguen funcionando).
# Puede apuntar a la base de logs del workflow (BD_LOGS): usa su propio esquema `monitor`.
MONITOR_DATABASE_URL=postgresql://user:password@localhost:5432/prisma_monitor
ARCHIVER_GROUP=prisma-monitor-archiver

# Cognito (mismo pool y app client que prisma-front). COGNITO_DOMAIN va SIN https://
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Tarifas en USD por millón de tokens. Sin tarifa, el costo se muestra "sin tarifa" (nunca 0).
# Complétalas con las de tu proveedor:
#   MODEL_PRICES={"gemini-3.1-flash-lite": {"input": X, "cached_input": Y, "output": Z}}
# `cached_input` es opcional; sin él, los tokens en caché se cobran a tarifa de entrada.
MODEL_PRICES={}

# Un flujo sin eventos por más de N minutos se muestra "detenido" y no cuenta como corriendo.
STALL_MINUTES=30
# Cuánto historial mantiene el agregador en memoria (igual a la retención del topic: 7 días).
RETENTION_HOURS=168
